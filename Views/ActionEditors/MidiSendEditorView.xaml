<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HotKeyManager.Views.ActionEditors.MidiSendEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12">
        <ComboBox Header="Ausgabegerät"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                  SelectedIndex="{x:Bind ViewModel.DeviceIndex, Mode=TwoWay}" />

        <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Header="Preset (dokumentierte Befehle)"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Kein Preset"
                              ItemsSource="{x:Bind ViewModel.PresetPicker.Presets, Mode=OneWay}"
                              DisplayMemberPath="Name"
                              SelectedIndex="{x:Bind ViewModel.PresetPicker.PresetIndex, Mode=TwoWay}" />
                    <Button Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Click="ImportPreset_Click"
                            ToolTipService.ToolTip="Preset-Datei (JSON) importieren">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                            <TextBlock Text="Importieren" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ComboBox Header="Befehl"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Befehl wählen…"
                          ItemsSource="{x:Bind ViewModel.PresetPicker.PresetCommands, Mode=OneWay}"
                          DisplayMemberPath="DisplayName"
                          SelectedIndex="{x:Bind ViewModel.PresetPicker.CommandIndex, Mode=TwoWay}" />

                <TextBlock Text="{x:Bind ViewModel.PresetPicker.CommandHint, Mode=OneWay}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.PresetPicker.HasCommandHint, Mode=OneWay}" />

                <TextBlock Text="{x:Bind ViewModel.PresetPicker.PresetNotes, Mode=OneWay}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.PresetPicker.HasPresetNotes, Mode=OneWay}" />

                <!-- Working values found by trial go back into the preset file, so they are kept. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="SaveAsNewCommand_Click">
                        <ToolTipService.ToolTip>
                            Aktuelle Einstellungen als neuen, verifizierten Preset-Eintrag speichern
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Als Preset-Eintrag speichern" />
                        </StackPanel>
                    </Button>
                    <Button Click="UpdateCommand_Click"
                            IsEnabled="{x:Bind ViewModel.PresetPicker.HasSelectedCommand, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            Gewählten Preset-Eintrag mit diesen Werten überschreiben und als verifiziert markieren
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                            <TextBlock Text="Eintrag aktualisieren" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenPresetFile_Click"
                            IsEnabled="{x:Bind ViewModel.PresetPicker.HasSelectedPreset, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            Preset-JSON im Standardprogramm öffnen und von Hand bearbeiten
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="12" />
                            <TextBlock Text="JSON öffnen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <ComboBox Header="Nachrichtentyp"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=TwoWay}">
            <ComboBoxItem Content="Note (Note On)" />
            <ComboBoxItem Content="Control Change (CC)" />
        </ComboBox>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox Grid.Column="0"
                       Header="Kanal (1-16)"
                       Value="{x:Bind ViewModel.Channel, Mode=TwoWay}"
                       Minimum="1" Maximum="16"
                       SpinButtonPlacementMode="Inline" />
            <NumberBox Grid.Column="1"
                       Header="Note / CC-Nr."
                       Value="{x:Bind ViewModel.Number, Mode=TwoWay}"
                       Minimum="0" Maximum="127"
                       SpinButtonPlacementMode="Inline" />
            <NumberBox Grid.Column="2"
                       Header="Wert"
                       Value="{x:Bind ViewModel.Value, Mode=TwoWay}"
                       Minimum="0" Maximum="127"
                       SpinButtonPlacementMode="Inline" />
        </Grid>

        <StackPanel Spacing="8">
            <CheckBox Content="Bei jedem Auslösen zwischen zwei Werten umschalten"
                      IsChecked="{x:Bind ViewModel.ToggleValues, Mode=TwoWay}" />
            <NumberBox Header="Zweiter Wert"
                       Value="{x:Bind ViewModel.ValueB, Mode=TwoWay}"
                       Minimum="0" Maximum="127"
                       SpinButtonPlacementMode="Inline"
                       HorizontalAlignment="Left"
                       MinWidth="200"
                       IsEnabled="{x:Bind ViewModel.ToggleValues, Mode=OneWay}" />
            <TextBlock FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                Sinnvoll für Geräte mit getrennten An/Aus-Befehlen (z.B. RØDECaster: CC 27 mit Wert 1 = stumm,
                Wert 0 = laut). Der zuletzt gesendete Wert wird gespeichert, damit ein Tastendruck zuverlässig
                umschaltet.
            </TextBlock>
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <NumberBox Grid.Column="0"
                       Header="Note-Off nach (ms, 0 = keins)"
                       Value="{x:Bind ViewModel.NoteOffAfterMs, Mode=TwoWay}"
                       Minimum="0" Maximum="10000"
                       SmallChange="10"
                       SpinButtonPlacementMode="Inline" />
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.TestSendCommand}"
                    ToolTipService.ToolTip="Nachricht jetzt einmal senden">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                    <TextBlock Text="Test senden" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Severity="Informational"
                 Title="Hinweis"
                 IsOpen="True"
                 IsClosable="False">
            <InfoBar.Message>
                Womit ein Gerät auf eingehende MIDI-Befehle reagiert, hängt vom Gerät ab. Mit „Test senden“
                probierst du einen Befehl direkt aus; funktionierende Werte kannst du oben dauerhaft ins Preset
                übernehmen.
            </InfoBar.Message>
        </InfoBar>
    </StackPanel>
</UserControl>
