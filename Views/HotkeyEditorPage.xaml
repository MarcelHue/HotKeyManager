<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HotKeyManager.Views.HotkeyEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ae="using:HotKeyManager.Views.ActionEditors"
    Background="Transparent">

    <Page.Resources>
        <!-- The block macro is the only top-level editor; the other editor templates
             live on as block templates in MacroEditorView.Resources. -->
        <DataTemplate x:Key="MacroEditorTemplate">
            <ae:MacroEditorView />
        </DataTemplate>

        <ae:ActionEditorTemplateSelector x:Key="ActionEditorSelector"
                                         MacroTemplate="{StaticResource MacroEditorTemplate}" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,0">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="16" Margin="0,0,0,24">

            <TextBlock Text="{x:Bind ViewModel.PageTitle}"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <InfoBar Severity="Error"
                     IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Allgemein" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <TextBox Header="Name"
                             Text="{x:Bind ViewModel.Name, Mode=TwoWay}"
                             PlaceholderText="z.B. Browser öffnen"
                             MaxLength="100" />

                    <ComboBox Header="Ordner (optional)"
                              HorizontalAlignment="Stretch"
                              IsEditable="True"
                              PlaceholderText="Ohne Ordner"
                              ItemsSource="{x:Bind ViewModel.KnownGroups}"
                              Text="{x:Bind ViewModel.Group, Mode=TwoWay}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Tastenkombination (optional, wenn MIDI gesetzt)" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12,10">
                                <TextBlock Text="{x:Bind ViewModel.Key.DisplayText, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.Key.StartCaptureCommand}"
                                    IsEnabled="{x:Bind ViewModel.Key.IsButtonEnabled, Mode=OneWay}"
                                    VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE765;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.Key.ButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.Key.ClearCommand}"
                                    Visibility="{x:Bind ViewModel.Key.HasKey, Mode=OneWay}"
                                    VerticalAlignment="Stretch"
                                    ToolTipService.ToolTip="Tastenkombination entfernen">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="MIDI-Trigger (optional, z.B. Rodecaster-Pad)" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12,10">
                                <TextBlock Text="{x:Bind ViewModel.Midi.DisplayText, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.Midi.StartLearnCommand}"
                                    IsEnabled="{x:Bind ViewModel.Midi.IsButtonEnabled, Mode=OneWay}"
                                    VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.Midi.ButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.Midi.ClearCommand}"
                                    Visibility="{x:Bind ViewModel.Midi.HasTrigger, Mode=OneWay}"
                                    VerticalAlignment="Stretch"
                                    ToolTipService.ToolTip="MIDI-Trigger entfernen">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Hidden unless PadDeck is installed, so users without a DisplayPad never see it. -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Pad.IsAvailable}">
                        <TextBlock Text="DisplayPad-Taste (optional, über PadDeck)" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12,10">
                                <TextBlock Text="{x:Bind ViewModel.Pad.DisplayText, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.Pad.StartLearnCommand}"
                                    IsEnabled="{x:Bind ViewModel.Pad.IsButtonEnabled, Mode=OneWay}"
                                    VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE80A;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.Pad.ButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.Pad.ClearCommand}"
                                    Visibility="{x:Bind ViewModel.Pad.HasTrigger, Mode=OneWay}"
                                    VerticalAlignment="Stretch"
                                    ToolTipService.ToolTip="DisplayPad-Taste freigeben">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.Pad.Hint, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Aktion" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <ContentControl Content="{x:Bind ViewModel.SelectedActionEditor, Mode=OneWay}"
                                    ContentTemplateSelector="{StaticResource ActionEditorSelector}"
                                    HorizontalContentAlignment="Stretch"
                                    IsTabStop="False" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Fenster-Optionen" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <RadioButtons SelectedIndex="{x:Bind ViewModel.Window.ModeIndex, Mode=TwoWay}">
                        <RadioButton Content="Keine Beschränkung" />
                        <RadioButton Content="Nur bei aktivem Fenster auslösen" />
                        <RadioButton Content="Tasten an Hintergrund-Fenster senden" />
                    </RadioButtons>

                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.Window.IsTargetVisible, Mode=OneWay}">
                        <TextBox Header="Prozessname"
                                 Text="{x:Bind ViewModel.Window.ProcessName, Mode=TwoWay}"
                                 PlaceholderText="z.B. notepad, chrome (ohne .exe)" />
                        <TextBox Header="Fenstertitel (optional)"
                                 Text="{x:Bind ViewModel.Window.WindowTitle, Mode=TwoWay}"
                                 PlaceholderText="z.B. *Editor* (* als Wildcard)" />
                        <Button Command="{x:Bind ViewModel.Window.CaptureCommand}"
                                IsEnabled="{x:Bind Not(ViewModel.Window.IsCapturing), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE78B;" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.Window.ButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <InfoBar Severity="Informational"
                                 Title="Fenster erfassen"
                                 Message="Wechsle innerhalb von 3 Sekunden zum gewünschten Fenster."
                                 IsOpen="{x:Bind ViewModel.Window.IsCapturing, Mode=OneWay}"
                                 IsClosable="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Abbrechen"
                        MinWidth="120"
                        Command="{x:Bind ViewModel.CancelCommand}" />
                <Button Content="Speichern"
                        MinWidth="120"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
