<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HotKeyManager.Views.HotkeyListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HotKeyManager.Views"
    xmlns:models="using:HotKeyManager.Models"
    xmlns:vm="using:HotKeyManager.ViewModels"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Page.Resources>
        <!-- Zeilen-Vorlage: Griff, Auslöser, Name/Aktion, Buttons -->
        <DataTemplate x:Key="HotkeyItemTemplate" x:DataType="models:HotkeyDefinition">
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Griff zum Ziehen (6 Punkte) -->
                    <Grid Grid.Column="0"
                          VerticalAlignment="Center"
                          Width="12"
                          RowSpacing="3"
                          ColumnSpacing="3"
                          Opacity="0.55"
                          ToolTipService.ToolTip="Ziehen zum Sortieren oder in einen Ordner verschieben">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Ellipse Grid.Row="0" Grid.Column="1" Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Ellipse Grid.Row="1" Grid.Column="0" Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Ellipse Grid.Row="1" Grid.Column="1" Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Ellipse Grid.Row="2" Grid.Column="0" Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Ellipse Grid.Row="2" Grid.Column="1" Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Auslöser-Badge: Klick öffnet die Erfassungs-Optionen -->
                    <Button Grid.Column="1"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Auslöser ändern">
                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,8"
                                MinWidth="120">
                            <TextBlock Text="{x:Bind TriggerDisplayText, Mode=OneWay}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource AccentBrush}" />
                        </Border>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Tastenkombination erfassen" Click="CaptureKey_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE765;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="MIDI-Trigger erfassen" Click="CaptureMidi_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEC4F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Tastenkombination entfernen" Click="ClearKey_Click" />
                                <MenuFlyoutItem Text="MIDI-Trigger entfernen" Click="ClearMidi_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Name und Aktionsbeschreibung -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <!-- Stift klebt direkt am Namen (Auto-Breite), nicht am Zeilenrand -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="420"
                                       VerticalAlignment="Center"
                                       DoubleTapped="Name_DoubleTapped"
                                       Visibility="{x:Bind IsNotEditingName, Mode=OneWay}" />

                            <TextBox Text="{x:Bind EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240"
                                     Visibility="{x:Bind IsEditingName, Mode=OneWay}"
                                     Loaded="RenameBox_Loaded"
                                     KeyDown="RenameBox_KeyDown"
                                     LostFocus="RenameBox_LostFocus" />

                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    Click="RenameHotkey_Click"
                                    Visibility="{x:Bind IsNotEditingName, Mode=OneWay}"
                                    ToolTipService.ToolTip="Namen umbenennen">
                                <FontIcon Glyph="&#xE8AC;" FontSize="12" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="{x:Bind Action.DisplayName}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind Action.Description}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Aktionen -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                      OnContent=""
                                      OffContent=""
                                      MinWidth="0"
                                      Toggled="ToggleSwitch_Toggled"
                                      ToolTipService.ToolTip="Hotkey aktivieren/deaktivieren" />
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="10"
                                Click="RunHotkey_Click"
                                ToolTipService.ToolTip="Jetzt ausführen">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="10"
                                Click="AssignGroup_Click"
                                ToolTipService.ToolTip="Ordner zuweisen">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        </Button>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="10"
                                Click="EditHotkey_Click"
                                ToolTipService.ToolTip="Makro bearbeiten">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="10"
                                Click="DuplicateHotkey_Click"
                                ToolTipService.ToolTip="Kopieren (alles außer Auslöser übernehmen)">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="10"
                                Click="DeleteHotkey_Click"
                                ToolTipService.ToolTip="Löschen">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#EF4444" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Meine Hotkeys" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <SplitButton Grid.Column="1"
                         Click="AddHotkey_Click"
                         VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Neuer Hotkey" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Neues Text-Makro" Click="AddTextMacro_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8D2;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
        </Grid>

        <!-- Suche -->
        <AutoSuggestBox Grid.Row="1"
                        x:Name="SearchBox"
                        QueryIcon="Find"
                        PlaceholderText="Hotkeys durchsuchen…"
                        MaxWidth="400"
                        HorizontalAlignment="Left"
                        TextChanged="SearchBox_TextChanged"
                        Margin="0,0,0,16" />

        <!-- Ordner + Liste -->
        <Grid Grid.Row="2">
            <StackPanel Visibility="{x:Bind ViewModel.IsEmptyStateVisible, Mode=OneWay}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE765;"
                          FontSize="56"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <Button Click="AddHotkey_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Hotkey erstellen" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HotkeyGroup">
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,8"
                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                      AllowDrop="True"
                                      DragOver="Group_DragOver"
                                      Drop="Group_Drop">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind CountText}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Expander.Header>

                                <ListView ItemsSource="{x:Bind Items}"
                                          ItemTemplate="{StaticResource HotkeyItemTemplate}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="False"
                                          AllowDrop="True"
                                          CanDragItems="True"
                                          CanReorderItems="True"
                                          DragItemsStarting="Items_DragItemsStarting"
                                          DragItemsCompleted="Items_DragItemsCompleted"
                                          DragOver="Group_DragOver"
                                          Drop="Group_Drop">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
